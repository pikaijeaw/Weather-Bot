# Signer key (hex) and its address — the key that owns your Polymarket account
PK=your_private_key_hex
WALLET=0xYourSignerAddress
# Polymarket deposit wallet address (polymarket.com profile menu) — holds the pUSD
FUNDER=0xYourPolymarketWalletAddress
# 3 = Polymarket deposit wallet (POLY_1271), 0 = trade directly from the EOA
SIG_TYPE=3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# dashboard login (user "admin")
DASHBOARD_PASSWORD=change-me
VC_KEY=
